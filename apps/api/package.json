{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:integration:docker": "docker info >/dev/null 2>&1 || { echo \"Docker is required for Testcontainers integration replay\" >&2; exit 1; }; vitest run --config vitest.integration.config.ts --reporter verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/postgres": "^6.1.2",
    "contracts": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
