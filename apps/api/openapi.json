{
  "openapi": "3.0.3",
  "info": {
    "title": "Users API",
    "version": "1.0.0",
    "description": "The users list and the login that mints a session token, as the Zod contracts in packages/contracts define them.",
    "contact": {
      "name": "validate-kit monorepo",
      "url": "https://github.com/CryptoKrad/validate-kit"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "The API in development"
    }
  ],
  "tags": [
    {
      "name": "users",
      "description": "The user list"
    },
    {
      "name": "auth",
      "description": "Sessions"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "description": "Every user, as the contract's UsersSchema shapes them.",
        "tags": [
          "users"
        ],
        "responses": {
          "200": {
            "description": "The user list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    },
                    "required": [
                      "id",
                      "email"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate and mint a session token",
        "description": "Checks the credentials in the body and returns a session token.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A session token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    }
  }
}
